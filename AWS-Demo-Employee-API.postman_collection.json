                "employees",
                "{{employeeId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('employeeId', body.id);",
                  "    pm.test('Employee created with an id', function () {",
                  "        pm.expect(body.id).to.not.be.undefined;",
                  "    });",
                  "} else {",
                  "    pm.test('Request failed', function () {",
                  "        pm.expect.fail('Expected 201, got ' + pm.response.code);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"department\": \"Engineering\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "description": "Creates a new employee. On success, the response's id is automatically saved into the {{employeeId}} collection variable for use by the other requests."
          },
          "response": []
        },
